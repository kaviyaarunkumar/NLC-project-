package com.nlc.materials;

import jakarta.servlet.ServletException;
import jakarta.servlet.annotation.WebServlet;
import jakarta.servlet.http.HttpServlet;
import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;
import java.io.IOException;
import java.io.PrintWriter;
import java.sql.Connection;
import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.sql.SQLException;

@WebServlet("/materials")
public class MaterialServlet extends HttpServlet {
    @Override
    protected void doGet(HttpServletRequest request, HttpServletResponse response) throws IOException {
        response.setContentType("text/html;charset=UTF-8");
        try (PrintWriter out = response.getWriter()) {
            out.println("<!doctype html><html lang='en'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'>");
            out.println("<title>Material Management</title><link href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css' rel='stylesheet'>");
            out.println("</head><body class='bg-light'><nav class='navbar navbar-dark bg-primary'><div class='container'><span class='navbar-brand'>Material Management System</span></div></nav>");
            out.println("<main class='container py-4'><h1 class='h3 mb-3'>Material Inventory</h1>");
            out.println("<div class='card mb-4'><div class='card-body'><h2 class='h5'>Add material</h2><form method='post' action='materials' class='row g-3'>");
            out.println("<div class='col-md-4'><label class='form-label' for='itemName'>Item name</label><input class='form-control' id='itemName' name='itemName' required maxlength='120'></div>");
            out.println("<div class='col-md-4'><label class='form-label' for='description'>Description</label><input class='form-control' id='description' name='description' maxlength='255'></div>");
            out.println("<div class='col-md-2'><label class='form-label' for='quantity'>Quantity</label><input class='form-control' id='quantity' name='quantity' type='number' min='0' required></div>");
            out.println("<div class='col-md-2'><label class='form-label' for='unit'>Unit</label><input class='form-control' id='unit' name='unit' value='pcs' required maxlength='30'></div>");
            out.println("<div class='col-12'><button class='btn btn-primary' type='submit'>Save material</button></div></form></div></div>");
            out.println("<div class='card'><div class='card-body'><h2 class='h5'>Current materials</h2><div class='table-responsive'><table class='table table-striped align-middle'><thead><tr><th>ID</th><th>Item</th><th>Description</th><th>Quantity</th><th>Unit</th></tr></thead><tbody>");
            try (Connection con = Database.getConnection(); PreparedStatement ps = con.prepareStatement("SELECT material_id,item_name,description,quantity,unit FROM materials ORDER BY material_id DESC"); ResultSet rs = ps.executeQuery()) {
                while (rs.next()) {
                    out.println("<tr><td>" + rs.getInt("material_id") + "</td><td>" + esc(rs.getString("item_name")) + "</td><td>" + esc(rs.getString("description")) + "</td><td>" + rs.getInt("quantity") + "</td><td>" + esc(rs.getString("unit")) + "</td></tr>");
                }
            } catch (SQLException e) {
                out.println("<tr><td colspan='5' class='text-danger'>Could not load materials. Check database setup and DB credentials.</td></tr>");
                getServletContext().log("Could not read materials", e);
            }
            out.println("</tbody></table></div></div></div><p class='text-secondary small mt-3'>Training/demo starter project. Do not enter confidential company data.</p></main></body></html>");
        }
    }

    @Override
    protected void doPost(HttpServletRequest request, HttpServletResponse response) throws IOException {
        request.setCharacterEncoding("UTF-8");
        String name = request.getParameter("itemName");
        String description = request.getParameter("description");
        String quantityText = request.getParameter("quantity");
        String unit = request.getParameter("unit");
        if (name == null || name.isBlank() || quantityText == null || unit == null || unit.isBlank()) {
            response.sendError(HttpServletResponse.SC_BAD_REQUEST, "Item name, quantity, and unit are required.");
            return;
        }
        try {
            int quantity = Integer.parseInt(quantityText);
            if (quantity < 0) throw new NumberFormatException("negative quantity");
            try (Connection con = Database.getConnection(); PreparedStatement ps = con.prepareStatement("INSERT INTO materials(item_name,description,quantity,unit) VALUES(?,?,?,?)")) {
                ps.setString(1, name.trim());
                ps.setString(2, description == null ? "" : description.trim());
                ps.setInt(3, quantity);
                ps.setString(4, unit.trim());
                ps.executeUpdate();
            }
            response.sendRedirect(request.getContextPath() + "/materials");
        } catch (NumberFormatException e) {
            response.sendError(HttpServletResponse.SC_BAD_REQUEST, "Quantity must be a non-negative whole number.");
        } catch (SQLException e) {
            getServletContext().log("Could not save material", e);
            response.sendError(HttpServletResponse.SC_INTERNAL_SERVER_ERROR, "Could not save material. Check database setup.");
        }
    }

    private static String esc(String value) {
        if (value == null) return "";
        return value.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;").replace("'", "&#x27;");
    }
}
